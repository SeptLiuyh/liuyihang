---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import { SITE } from "../config/site";

interface Props {
  title?: string;
}

const { title = `${SITE.name} | ${SITE.nameEn}` } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={`${SITE.name} — 摄影作品集`} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
  </head>
  <body>
    <Nav />
    <main class="main">
      <slot />
    </main>
    <!-- GSAP 本地静态加载，避免开发服务器依赖缓存失效导致轮播中断 -->
    <script is:inline src={`${import.meta.env.BASE_URL}vendor/gsap.min.js`}></script>
    <script>
      import "../scripts/animation";
    </script>
  </body>
</html>
