---
import Layout from "../layouts/Layout.astro";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// 首页右侧全屏轮播：读取 src/photos/home/ 下的所有图片
const images = import.meta.glob(
  "../photos/home/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,gif}",
  {
    eager: true,
    import: "default",
  }
);

const raw = Object.entries(images)
  .map(([path, src]) => ({
    src: src as ImageMetadata,
    name: path.split("/").pop()!.replace(/\.[^.]+$/, ""),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));

// 生成优化后的 webp 地址；页面只先加载第一张，其余由轮播脚本按需加载
const slides = await Promise.all(
  raw.map(async (slide) => {
    const opt = await getImage({
      src: slide.src,
      width: 1600,
      format: "webp",
      quality: 75,
    });
    return {
      url: opt.src,
      name: slide.name,
      ar: `${slide.src.width}/${slide.src.height}`,
      arNum: (slide.src.width / slide.src.height).toFixed(4),
    };
  })
);
---

<Layout>
  <div
    class="slideshow"
    aria-label="摄影作品轮播"
    style={`--ar: ${slides[0]?.ar ?? "3/2"}; --ar-num: ${slides[0]?.arNum ?? "1.5"}`}
  >
    {
      slides.map((slide, i) => (
        <div class="slide" data-ar={slide.ar} data-ar-num={slide.arNum}>
          <img
            {...(i === 0 ? { src: slide.url } : {})}
            data-src={slide.url}
            alt={slide.name}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
</Layout>

<script>
  import "../scripts/slideshow";
</script>
