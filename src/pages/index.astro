---
import Layout from "../layouts/Layout.astro";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

// 首页右侧全屏轮播：读取 src/photos/home/ 下的所有图片
const images = import.meta.glob(
  "../photos/home/*.{jpg,JPG,jpeg,JPEG,png,PNG,webp,gif}",
  {
    eager: true,
    import: "default",
  }
);

const slides = Object.entries(images)
  .map(([path, src]) => ({
    src: src as ImageMetadata,
    name: path.split("/").pop()!.replace(/\.[^.]+$/, ""),
    ar: `${(src as ImageMetadata).width}/${(src as ImageMetadata).height}`,
    arNum: (
      (src as ImageMetadata).width / (src as ImageMetadata).height
    ).toFixed(4),
  }))
  .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
---

<Layout>
  <div
    class="slideshow"
    aria-label="摄影作品轮播"
    style={`--ar: ${slides[0]?.ar ?? "3/2"}; --ar-num: ${slides[0]?.arNum ?? "1.5"}`}
  >
    {
      slides.map((slide) => (
        <div class="slide" data-ar={slide.ar} data-ar-num={slide.arNum}>
          <Image
            src={slide.src}
            alt={slide.name}
            width={1920}
            fit="inside"
            format="webp"
            quality={80}
            decoding="async"
          />
        </div>
      ))
    }
  </div>
</Layout>

<script>
  import "../scripts/slideshow";
</script>
